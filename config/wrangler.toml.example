# fata CF Worker — wrangler.toml 模板
# 复制此文件为 wrangler.toml 并填入你自己的值

name = "fata-api-proxy"
main = "config/worker.js"
compatibility_date = "2026-06-13"

# --- 路由配置 ---
routes = [
  { pattern = "YOUR_DOMAIN/api/*", zone_id = "YOUR_ZONE_ID" }
]

# --- 环境变量（非敏感） ---
[vars]
ALLOWED_ORIGINS = "https://YOUR_DOMAIN"
GITHUB_API_BASE = "https://api.github.com"
GITHUB_REPO_OWNER = "YOUR_GITHUB_USERNAME"
GITHUB_REPO_NAME = "fata"
RESEND_API_BASE = "https://api.resend.com"
DEEPSEEK_API_BASE = "https://api.deepseek.com/v1"

# --- 以下通过 wrangler secret put 设置，不写在这个文件中 ---
# GITHUB_PAT
# DEEPSEEK_API_KEY
# RESEND_API_KEY
# HMAC_SECRET
