# ===== fata .gitignore =====
# 原则：不进 git 是默认。
# 只有必须公开才能证明"架构即隐私"的文件才放进去。

# --- 密钥和凭证 ---
.env
.dev.vars
.wrangler/

# --- 算法护城河 ---
modules/match-engine.js
config/worker.js
config/algorithm-config.json
config/changelog.md
config/wrangler.toml

# --- 研发文档（除了 README 和 github-setup，全部排除） ---
00-*.md
0[2-9]-*.md
1[0-9]-*.md
naming-*.md
state-stranger-matcher.md
CLAUDE.md
AGENTS.md
todo.md
config/github-setup.md

# --- 安全事故报告（内部保留，不公开） ---
INCIDENT-*.md
SECURITY-HMAC-*.md

# --- 内部运维文档（不公开） ---
production-loops.md

# --- 内部开发工具（不对外暴露） ---
tools/inject-en-bootstrap.js
tools/inject-en-bootstrap-bge.py

# --- 内部开发（设计草稿、配置模板） ---
logo/logo-v*.html
logo/logo-showcase.html
logo/logo-sketches.html
logo/logo-system.html
logo/logo-wave-type.html
logo/截屏*
assets/
config/wrangler.toml.example
config/algorithm-config.example.json

# --- Claude Code ---
.claude/

# --- 操作系统 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# --- macOS ---
.AppleDouble
.LSOverride
Icon
._*

# --- Playwright automation ---
.playwright-mcp/

# --- 内部工具（不对外暴露） ---
*.local.*
tools/e2e-test.js
tools/audit.js
tools/audit-logs/
tools/algo-test.js
tools/algo-test-logs/
tools/evaluate-matching.js
tools/inject-en-seeds.js
tools/seed-injector.html
tools/seed-injector-en.html
config/test-pairs.json
config/scenario-tests.json
分发.md

# --- 构建产物 ---
dist/
node_modules/

# --- Codex 内部备份（不公开） ---
codex/private-worker/
codex/snapshots/
